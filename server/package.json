{
  "name": "azurrp-api",
  "version": "1.0.0",
  "private": true,
  "description": "API d'authentification et de contenu pour le launcher AzurRP",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:local": "node src/local.js",
